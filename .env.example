# Copy to .env and adjust.
POSTGRES_PASSWORD=change-me-to-something-long
GAME_PORT=8787

# Optional AI (start with: docker compose --profile ai up -d)
RUTZARG_LLM=off
# RUTZARG_LLM=ollama
# LLM_URL=http://ollama:11434        # the bundled Ollama service
# LLM_URL=http://host.docker.internal:11434   # Ollama running on the host machine (Docker Desktop)
LLM_MODEL=gemma3:4b

# Accounts & sign-in
# Public address of the game (used for the Google redirect), e.g. https://rutzarg.example.com
PUBLIC_URL=
# Google sign-in: https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Guest play without an account (1 = allowed). On a public server keep 0.
ALLOW_GUESTS=0
